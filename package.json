{
  "name": "supercool-ledger",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "bun": "1.3.13"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "bun scripts/migrate.ts",
    "reconcile": "bun scripts/reconcile.ts",
    "demo": "bun scripts/demo.ts",
    "demo:capture": "bun scripts/demo-capture.ts",
    "ai:export": "bun scripts/export-ai-history.ts",
    "video:voice": "bun scripts/video-voice.ts",
    "video:render": "bunx remotion render video/index.ts SuperCoolLedger video/out/supercool-ledger.mp4 --public-dir=video/public",
    "video:still": "bunx remotion still video/index.ts SuperCoolLedger video/out/poster.png --frame=2400 --public-dir=video/public",
    "openapi:generate": "bun scripts/openapi.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^10.5.0",
    "@sinclair/typebox": "^0.34.41",
    "fastify": "^5.5.0",
    "jose": "^6.2.10",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@remotion/cli": "^4.0.517",
    "@remotion/media": "^4.0.517",
    "@remotion/media-utils": "^4.0.517",
    "@types/bun": "^1.2.21",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.34.0",
    "fast-check": "^4.3.0",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.517",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
